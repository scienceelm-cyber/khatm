# Docker Compose database password. Generate a strong random value.
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_STRONG_DATABASE_PASSWORD

# PostgreSQL connection used by the Next.js server when running outside Compose.
DATABASE_URL=postgresql://khatm:REPLACE_ME_WITH_A_STRONG_DATABASE_PASSWORD@localhost:5432/khatm
DATABASE_SSL=false

# Secret required to change the shared khatm intention from the UI.
# Must be at least 20 characters and MUST NOT keep this placeholder value.
ADMIN_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# Claim lifetime. Server clamps this to 10..180 minutes.
CLAIM_TTL_MINUTES=45

# Quran content provider.
QURAN_API_BASE=https://api.alquran.cloud/v1
QURAN_ARABIC_EDITION=quran-uthmani-quran-academy
QURAN_PERSIAN_EDITION=fa.makarem
QURAN_AUDIO_EDITION=ar.alafasy
QURAN_AUDIO_BITRATE=128
